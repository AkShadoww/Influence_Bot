# ===========================================
# INFLUENCE BOT - Environment Configuration
# ===========================================

# --- ReelStats API ---
BOT_TOKEN=your-reelstats-bot-token
REELSTATS_API_URL=https://campaign.influence.technology

# --- Slack Configuration ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
# Fallback channel — used when a per-type channel below is unset.
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Per-notification-type channels. Each accepts either a channel name
# (e.g. "#content-reviews") or a channel ID (e.g. "C0XXXXXXXXX").
# The bot must be a member of each channel or posts fail with `not_in_channel`.
# Resolution order: env var → SLACK_CHANNEL_ID → hardcoded default in config.py.
SLACK_CHANNEL_REVIEWS=#content-reviews           # review_submitted webhook
SLACK_CHANNEL_UPLOADS=#content-uploads           # video_links_submitted + upload follow-ups
SLACK_CHANNEL_PAYMENTS=#payment-reminders        # deliverables-complete + daily payment summary
SLACK_CHANNEL_MILESTONES=#breakout-content-alerts # view milestones (250K, 500K, 1M, ...)
SLACK_CHANNEL_DEADLINES=#creator-deadlines       # deadline reminders (3d / 1d / overdue)

# Optional. Mention prepended to inbound creator/brand chat pings in the
# reviews channel so the team gets a hard notification even with the channel
# muted (the pings thread under the review post and are already broadcast to
# the channel; this adds the ping). Use a user-group ("<!subteam^S012ABC3>"),
# a user ("<@U012ABC3>"), or "<!here>" / "<!channel>". Leave unset for
# broadcast-only.
# SLACK_REVIEWS_NOTIFY=<!subteam^S012ABC3>

# --- Email Configuration (jennifer@useinfluence.xyz) ---
# Railway blocks outbound SMTP on most plans, so email is sent via Resend's
# HTTPS API. The From/Reply-To domains must be verified on the Resend account
# that issued RESEND_API_KEY.
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM_ADDRESS=jennifer@useinfluence.xyz
EMAIL_FROM_NAME=Jennifer - INFLUENCE
# Optional — where creator replies are routed (defaults to EMAIL_FROM_ADDRESS).
# EMAIL_REPLY_TO=team@useinfluence.xyz

# --- Application ---
# Port binding is handled by the process manager (gunicorn on Railway reads
# $PORT automatically), so APP_HOST / APP_PORT are no longer needed.
#
# DATABASE_URL default is the local SQLite file. On Railway, mount a
# Volume at /data and set the four-slash absolute form below:
#   DATABASE_URL=sqlite:////data/influence_bot.db
DATABASE_URL=sqlite:///influence_bot.db
# Safety-net fallback poll cadence (real-time notifications arrive via
# ReelStats webhooks). POLL_INTERVAL_MINUTES is accepted for backwards
# compatibility but POLL_INTERVAL_SECONDS wins if both are set.
POLL_INTERVAL_SECONDS=60

# --- Campaign updates to creators over WhatsApp ---
# This bot sees what happens to a creator's content — a draft submitted, a
# brand approving it, feedback typed into the review chat, a post link, all
# deliverables complete — and tells Slack and email about it. Setting the two
# vars below also sends it to the CREATOR, on WhatsApp.
#
# The split is simply who knows what: this bot has the events, and the outreach
# service (Influence-Inc/Outreach_Email_Automation) has the creators' phone
# numbers, the WhatsApp Business credentials and Meta's approved message
# templates. So the bot reports an Instagram handle and a campaign, and every
# decision needing data it doesn't have — is this creator subscribed, is their
# 24h WhatsApp window open, send now or queue it — is made over there.
#
# OUTREACH_API_BASE is the outreach service's public base URL; OUTREACH_BOT_TOKEN
# must match the OUTREACH_BOT_TOKEN set on that service (it's sent as the
# x-bot-token header, the same scheme as BOT_TOKEN above).
#
# With either unset, campaign updates are skipped entirely — the bot's Slack and
# email notifications are unaffected, creators simply don't get the WhatsApp
# copy. Sends are fire-and-forget on a background thread and never raise, so an
# unreachable outreach service costs the WhatsApp message, never the Slack post.
# OUTREACH_API_BASE=https://outreach.your-domain.com
# OUTREACH_BOT_TOKEN=the-same-token-as-the-outreach-service
# Optional per-request timeout in seconds (default 10).
# OUTREACH_API_TIMEOUT=10

# --- Testing ---
# If set, the bot only processes the campaign with this exact name.
# Leave empty in production to process all campaigns.
# TEST_CAMPAIGN_NAME=Dummy testing
